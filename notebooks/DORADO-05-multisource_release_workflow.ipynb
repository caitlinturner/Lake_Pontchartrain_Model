   "source": [
    "#### Timestep Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "632acd70-3555-4d9b-bb98-aed59d0b8e86",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Particle release start: 2013-03-01 00:00:00\n",
      "Start range (hour-of-year): 1416\n",
      "Run hydrodt (hours): 24\n",
      "Hours remaining in model window: 7319\n",
      "Actual timesteps run: 304\n"
     ]
    }
   ],
   "source": [
    "release_dt = pd.Timestamp(particles_start_date)\n",
    "year_start = pd.Timestamp(year=release_dt.year, month=1, day=1)\n",
    "startRange = int((release_dt - year_start) / pd.Timedelta(hours=1))  # hour-of-year of first release\n",
    "if startRange < 0 or startRange >= len(unstructured[\"time\"]):\n",
    "    raise ValueError(f\"startRange={startRange} outside model time range [0, {len(unstructured['time']) - 1}].\")\n",
    "\n",
    "endRange = len(unstructured[\"time\"]) - 1\n",
    "timesteps = (endRange - startRange) // hydrodt\n",
    "model_timestep = 3600 * hydrodt  # seconds between model steps\n",
    "timesteps_to_run = timesteps\n",
    "\n",
    "# Align every source's per-step array to the run length (pad/truncate with zeros)\n",
    "for name in list(steps_by_source.keys()):\n",
    "    arr = steps_by_source[name]\n",
    "    if len(arr) < timesteps_to_run:\n",
    "        arr = np.pad(arr, (0, timesteps_to_run - len(arr)), mode=\"constant\")\n",
    "    else:\n",
    "        arr = arr[:timesteps_to_run]\n",
    "    steps_by_source[name] = arr\n",
    "\n",
    "target_times = [int(t) for t in np.arange(0, model_timestep * (timesteps_to_run + 1), model_timestep)]\n",
    "prev_counts = None\n",
    "\n",
    "params = pt.modelParams()\n",
    "params.theta = 1.0\n",
    "params.gamma = 0.05\n",
    "params.diff_coeff = 0.8\n",
    "params.cell_type = np.where(np.isnan(elevation), 2, celltype_initial)\n",
    "params.dx = resolution\n",
    "params.dry_depth = 0.01\n",
    "params.verbose = False\n",
    "\n",
    "print(\"Particle release start:\", release_dt)\n",
    "print(\"Start range (hour-of-year):\", startRange)\n",
    "print(\"Run hydrodt (hours):\", hydrodt)\n",
    "print(\"Hours remaining in model window:\", endRange - startRange)\n",
    "print(\"Actual timesteps run:\", timesteps_to_run)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "96b901de-07c2-4870-9448-925ea6584f65",
   "metadata": {},
   "source": [
    "### 6. Run Dorado Iterations\n",
    "\n",
    "At every model step we rebuild the flow field, then seed each active source in\n",
    "turn onto a single `Particles` object before advancing. The first\n",
    "`generate_particles` call of each step pulls in the running `walk_data` via\n",
    "`previous_walk_data`; later calls in the same step append to it (dorado keeps the\n",
    "growing set on `Particles.walk_data`), so multiple sources with different counts\n",
    "are released together without overwriting one another. A source that releases\n",
    "zero particles on a step simply adds nothing."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "02afc3d0-99fb-4fb0-b3f4-83ccd9da4798",
   "metadata": {},
   "outputs": [],
   "source": [
    "first_ever = True\n",
    "for i in range(timesteps_to_run):\n",
    "    tti = startRange + i * hydrodt\n",
    "\n",
    "    stage = myInterp(unstructured[\"timesteps\"][tti][0])\n",
    "    depth = myInterp(unstructured[\"timesteps\"][tti][1])\n",
    "    u = myInterp(unstructured[\"timesteps\"][tti][2])\n",
    "    v = myInterp(unstructured[\"timesteps\"][tti][3])\n",
    "\n",
    "    for arr in [stage, depth, u, v]:\n",
    "        sub = arr[interpolate_indices[0]:interpolate_indices[1], interpolate_indices[2]:interpolate_indices[3]]\n",
    "        arr[interpolate_indices[0]:interpolate_indices[1], interpolate_indices[2]:interpolate_indices[3]] = \\\n",
    "            pd.DataFrame(sub).interpolate().values\n",
    "\n",
    "    params.topography = elevation\n",
    "    params.stage = stage\n",
    "    params.qx = u * depth\n",
    "    params.qy = v * depth\n",
    "\n",
    "\n",
    "    particle = pt.Particles(params)\n",
    "\n",
    "    seed_t = 0.0 if first_ever else float(target_times[i])\n",
    "    loaded_prev = False\n",
    "    for s in SOURCES:\n",
    "        n = int(steps_by_source[s[\"name\"]][i])\n",
    "        sx, sy = seed_cells[s[\"name\"]]\n",
    "        if not loaded_prev:\n",
    "            # Bring in the cumulative walk_data: This is set up to potentially bring in previous walk data. I have not used this yet, but set it up for potential future use\n",
    "            prev = None if first_ever else walk_data\n",
    "            particle.generate_particles(n, sx, sy, seed_time=seed_t,\n",
    "                                        method=\"exact\", previous_walk_data=prev)\n",
    "            loaded_prev = True\n",
    "            first_ever = False\n",
    "        else:\n",
    "            # Subsequent sources this step append to Particles.walk_data\n",
    "            particle.generate_particles(n, sx, sy, seed_time=seed_t, method=\"exact\")\n",
    "\n",
    "    walk_data = particle.run_iteration(target_times[i])\n",
    "    xi, yi, ti = dorado.routines.get_state(walk_data)\n",
    "\n",
    "    # Rebuild travel_times consistently across the fixed target-time grid (Needs to be done for this constant release and updating)\n",
    "    x_key = \"xinds\" if \"xinds\" in walk_data else \"x_inds\"\n",
    "    t_key = \"travel_times\"\n",
    "    x_lists = walk_data[x_key]\n",
    "    t_lists = walk_data.get(t_key, [[] for _ in x_lists])\n",
    "    walk_data[t_key] = t_lists\n",
    "\n",
    "    if prev_counts is None or len(prev_counts) != len(x_lists):\n",
    "        prev_counts = [0] * len(x_lists)\n",
    "\n",
    "    t_start = target_times[i - 1] if i > 0 else 0\n",
    "    t_end = target_times[i]\n",
    "\n",
    "    for p, x_list in enumerate(x_lists):\n",
    "        cur_len = len(x_list)\n",
    "        added = cur_len - prev_counts[p]\n",
    "        if added <= 0:\n",
    "            continue\n",
    "        seg = [target_times[i]] * added\n",
    "        if len(t_lists[p]) < cur_len:\n",
    "            t_lists[p].extend([None] * (cur_len - len(t_lists[p])))\n",
    "        t_lists[p][prev_counts[p]:cur_len] = seg\n",
    "        prev_counts[p] = cur_len\n",
    "\n",
    "    # Particles that are still present at the last timestep \n",
    "    # use np.nan so downstream exposure ignores their terminal\n",
    "    # time instead of treating them as having exited the system\n",
    "    if i == timesteps_to_run - 1:\n",
    "        final_len = max(len(x_list) for x_list in x_lists)\n",
    "        for p, x_list in enumerate(x_lists):\n",
    "            if len(x_list) == final_len and t_lists[p]:\n",
    "                t_lists[p][-1] = np.nan\n",
    "\n",
    "    if i % 28 == 0 or i == timesteps_to_run - 1:\n",
    "        fig, ax = plt.subplots(figsize=(6, 4), dpi=200)\n",
    "        ax.scatter(yi, xi, c=\"firebrick\", s=1)\n",
    "        im = ax.imshow(particle.depth * -1, vmin=0, vmax=-25)\n",
    "        plt.imshow(regions, cmap=\"bone\", alpha=0.3)\n",
    "        plt.title(f\"Time: {int((target_times[i] / 3600) // hydrodt)} Timesteps Since Release\")  \n",
    "        cbar = plt.colorbar(im, ax=ax, fraction=0.046, pad=0.04, shrink = 0.7) \n",
    "        cbar.set_label(\"Depth (m)\")\n",
    "        ax.set_facecolor(\"whitesmoke\")\n",
    "        plt.savefig(path2folder / f\"output_by_dt{i}.png\")\n",
    "        plt.close()"
   ]
  },
