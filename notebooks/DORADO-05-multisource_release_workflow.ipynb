    "### 1. Configure Paths and Runtime Settings\n",
    "\n",
    "#### If you are releasing particles from a source and have not created the unstructured file, run the `\"build\"` branch first. If the unstructured file already exists, set `unstructured_mode = \"load\"`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "162cf97b-db9a-4818-91c5-88973a26497b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Unstructured mode: load\n",
      "Unstructured source: c:\\Users\\hydro\\Lake_Pontchartrain_Model\\outputs\\dorado\\diversion_2013_01\\unstructured_model_Delft3DFM_diversion_2013_01.txt\n"
     ]
    }
   ],
   "source": [
    "PROJECT_ROOT = Path.cwd().parent\n",
    "NOTEBOOK_DATA = PROJECT_ROOT / \"notebooks\" / \"data\"\n",
    "\n",
    "# Core run identifier shared across the notebook\n",
    "model_run = \"diversion_2013_01\"\n",
    "\n",
    "# A short tag for the output subfolder (rename per experiment, e.g. \"multi_source\")\n",
    "release_tag = \"multi_source\"\n",
    "\n",
    "# Choose how to populate `unstructured`:\n",
    "#   \"load\"  -> read an existing JSON created previously\n",
    "#   \"build\" -> create from FlowFM_map.nc and save to disk\n",
    "unstructured_mode = \"load\"  # options: \"load\" or \"build\"\n",
    "\n",
    "unstructured_data_location = (\n",
    "    PROJECT_ROOT / \"outputs\" / \"dorado\" / model_run\n",
    "    / f\"unstructured_model_Delft3DFM_{model_run}.txt\")\n",
    "\n",
    "# Only used when unstructured_mode == \"build\"\n",
    "data_folder = Path(r\"C:\\Users\\hydro\\BCS_Paper\\WL_Lake_Pontchartrain_Model_2013.dsproj_data\\FlowFM\\output\")\n",
    "\n",
    "if unstructured_mode == \"build\":\n",
    "    with xr.open_dataset(data_folder / \"FlowFM_map.nc\") as map_xr:\n",
    "        x = map_xr[\"mesh2d_face_x\"].values.astype(np.float32).tolist()\n",
    "        y = map_xr[\"mesh2d_face_y\"].values.astype(np.float32).tolist()\n",
    "        elevation = map_xr[\"mesh2d_flowelem_bl\"].values.astype(np.float32).tolist()\n",
    "        time = map_xr[\"time\"].values.astype(np.float32).tolist()\n",
    "\n",
    "        unstructured = {\n",
    "            \"time\": time[1:],\n",
    "            \"elevation\": elevation,\n",
    "            \"x_face\": x,\n",
    "            \"y_face\": y,\n",
    "            \"timesteps\": [],\n",
    "        }\n",
    "\n",
    "        for i in range(len(time) - 1):\n",
    "            stage = map_xr[\"mesh2d_s1\"].isel(time=1 + i).values.astype(np.float32)\n",
    "            depth = map_xr[\"mesh2d_waterdepth\"].isel(time=1 + i).values.astype(np.float32)\n",
    "            u = map_xr[\"mesh2d_ucx\"].isel(time=1 + i).values.astype(np.float32)\n",
    "            v = map_xr[\"mesh2d_ucy\"].isel(time=1 + i).values.astype(np.float32)\n",
    "            unstructured[\"timesteps\"].append([stage.tolist(), depth.tolist(), u.tolist(), v.tolist()])\n",
    "\n",
    "    unstructured_data_location.parent.mkdir(parents=True, exist_ok=True)\n",
    "    with open(unstructured_data_location, \"w\") as f:\n",
    "        json.dump(unstructured, f)\n",
    "\n",
    "elif unstructured_mode == \"load\":\n",
    "    with open(unstructured_data_location, \"r\") as f:\n",
    "        unstructured = json.load(f)\n",
    "\n",
    "print(\"Unstructured mode:\", unstructured_mode)\n",
    "print(\"Unstructured source:\", unstructured_data_location)"
   ]
