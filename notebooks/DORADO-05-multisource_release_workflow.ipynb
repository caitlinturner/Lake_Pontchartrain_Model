   "source": [
    "### 4. Project Coordinates, Grid Data, and Load Cell Types"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "87c4e8bf-b7b7-4bb6-b19a-aa46b19d14bb",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "731373.01 838696.8 3308499.64 3365342.66\n",
      "13805\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1800x1200 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Define UTM Zone\n",
    "utm_proj = Proj(proj=\"utm\", zone=15, ellps=\"WGS84\")\n",
    "\n",
    "# Convert unstructured grid lon/lat to UTM\n",
    "(unstructured[\"x\"], unstructured[\"y\"]) = utm_proj(unstructured[\"x_face\"], unstructured[\"y_face\"])\n",
    "unstructured[\"x\"], unstructured[\"y\"] = np.round(unstructured[\"x\"], 2), np.round(unstructured[\"y\"], 2)\n",
    "\n",
    "# Convert land boundaries lon/lat to UTM\n",
    "boundaries[\"x\"], boundaries[\"y\"] = utm_proj(boundaries[\"x\"], boundaries[\"y\"])\n",
    "\n",
    "coordinates = [(round(float(px), 2), round(float(py), 2))\n",
    "               for px, py in zip(unstructured[\"x\"], unstructured[\"y\"])]\n",
    "\n",
    "print(min(unstructured[\"x\"]), max(unstructured[\"x\"]),\n",
    "      min(unstructured[\"y\"]), max(unstructured[\"y\"]))\n",
    "print(len(unstructured[\"x\"]))\n",
    "\n",
    "resolution = 100  # meters (see release-location notes if you change model resolution)\n",
    "knn = 5           # nearest neighbors used\n",
    "myInterp, elevation = pt.unstruct2grid(coordinates, unstructured[\"elevation\"],\n",
    "                                       resolution, knn, boundary=boundaries, crop=True)\n",
    "\n",
    "# Grid origin (lower-left) used to convert coordinates <-> indices\n",
    "origin_xy = (min(unstructured[\"x\"]), min(unstructured[\"y\"]))\n",
    "\n",
    "# Set ocean boundary and fix area that was cut\n",
    "interpolate_indices = (320, 324, 779, 782)\n",
    "elevation[interpolate_indices[0]:interpolate_indices[1], interpolate_indices[2]:interpolate_indices[3]] = \\\n",
    "    pd.DataFrame(elevation[interpolate_indices[0]:interpolate_indices[1],\n",
    "                           interpolate_indices[2]:interpolate_indices[3]]).interpolate().values\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(6, 4), dpi=300)\n",
    "cax = ax.imshow(elevation, vmin=-10, vmax=0)\n",
    "cbar = fig.colorbar(cax, ax=ax, label=\"Depth (m)\", shrink=0.65)\n",
    "ax.set_xlabel(\"Longitude Index\", fontsize=12)\n",
