   "cell_type": "markdown",
   "id": "b368d7aa-52e4-424f-97f3-8595ab4cbb4b",
   "metadata": {},
   "source": [
    "### 3. Build the Combined Release Schedule\n",
    "\n",
    "Each source is placed on a shared daily calendar spanning the union of all active\n",
    "days. A source contributes zeros outside its own window. Daily totals are then\n",
    "distributed across the `steps_per_day` model steps, exactly as in the original\n",
    "workflow, giving one integer count per source per model step."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "132da44b-d3c0-45c0-8ac5-6bf7d29ebe0f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Release window: 2013-03-01 -> 2013-09-30\n",
      "  west: 856 particles\n",
      "  east: 856 particles\n",
      "Total particles: 1712\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 2100x1200 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "fill_missing_days = \"zero\"  # \"zero\" or \"interpolate\" (within each source's span)\n",
    "\n",
    "daily_by_source = {s[\"name\"]: build_daily_series(s[\"schedule\"]) for s in SOURCES}\n",
    "\n",
    "active = {n: s[s > 0] for n, s in daily_by_source.items()}\n",
    "if not any(len(s) for s in active.values()):\n",
    "    raise ValueError(\"No source has any positive-release days.\")\n",
    "\n",
    "global_start = min(s.index.min() for s in active.values() if len(s))\n",
    "global_end = max(s.index.max() for s in active.values() if len(s))\n",
    "full_index = pd.date_range(global_start, global_end, freq=\"D\")\n",
    "\n",
    "for name, s in daily_by_source.items():\n",
    "    s2 = s.reindex(full_index)\n",
    "    if fill_missing_days == \"interpolate\":\n",
    "        s2 = s2.interpolate(method=\"time\", limit_direction=\"both\")\n",
    "    daily_by_source[name] = s2.fillna(0).clip(lower=0)\n",
    "\n",
    "particles_start_date = pd.Timestamp(global_start)\n",
    "\n",
    "steps_by_source = {name: daily_to_steps(s.to_numpy(), steps_per_day)\n",
    "                   for name, s in daily_by_source.items()}\n",
    "\n",
    "total_by_source = {name: int(arr.sum()) for name, arr in steps_by_source.items()}\n",
    "print(\"Release window:\", global_start.date(), \"->\", global_end.date())\n",
    "for name, total in total_by_source.items():\n",
    "    print(f\"  {name}: {total} particles\")\n",
    "print(\"Total particles:\", sum(total_by_source.values()))\n",
    "\n",
    "# Plot daily particles per source\n",
    "fig, ax = plt.subplots(figsize=(7, 4), dpi=300)\n",
    "for name, s in daily_by_source.items():\n",
    "    ax.plot(s.index, np.round(s.to_numpy()).astype(int), linewidth=0.9, label=name)\n",
    "ax.set_title(\"Particles Per Day by Source\")\n",
    "ax.set_xlabel(\"Date\")\n",
    "ax.set_ylabel(\"Particle Count\")\n",
    "ax.legend(fontsize=8)\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
